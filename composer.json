{
	"name": "mediawiki/sapphire-spam-cleanse",
	"description": "MediaWiki extension for interactively removing spam users and their content",
	"type": "mediawiki-extension",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/Nikerabbit/mediawiki-extensions-SapphireSpamCleanse",
	"authors": [
		{
			"name": "Niklas Laxström",
			"email": "niklas.laxstrom@gmail.com",
			"role": "Author"
		}
	],
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.3.0"
		},
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require": {
		"php": ">=8.3",
		"composer/installers": "^1.0.1 || ^2.0",
		"ext-readline": "*"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "v52.0.1",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-parallel-lint": "v1.4.0",
		"rector/rector": "^2.1"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"parallel-lint . --exclude vendor",
			"phpcs -p -s",
			"minus-x check ."
		],
		"phan": "phan -d . --long-progress-bar",
		"rector": "rector"
	}
}
